{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32F103RB Debug (Renode)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "executable": "${workspaceFolder}/build/debug/stm32f103rb-app",
      "cwd": "${workspaceFolder}",
      "runToEntryPoint": "main"
    }
  ]
}